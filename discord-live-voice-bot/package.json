{
  "name": "discord-live-voice-bot",
  "version": "1.0.0",
  "description": "Ultra-low latency browser microphone broadcasting into Discord voice channels with DAVE E2EE",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:client": "npm --prefix client run dev",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/index.js",
    "start:dev": "tsx src/index.ts"
  },
  "keywords": [
    "discord",
    "voice",
    "live-mic",
    "push-to-talk",
    "dave",
    "ultra-low-latency",
    "socket.io",
    "webaudio"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@discordjs/opus": "^0.11.0",
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.2.0",
    "cors": "^2.8.6",
    "discord.js": "^14.28.1",
    "discord.js-selfbot-v13": "^3.7.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "concurrently": "^9.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}
